# Copia este archivo como .env en la raíz del monorepo y rellená las claves.
# .env está en .gitignore y NUNCA se sube (el repo es público).
# Lo cargan solo los entry points (separatio, separatio-check, ipcheck);
# las librerías leen os.environ.
# Respaldo manual de las claves: bóveda Bitwarden/rbw, nota "Intel API keys".

# ── LLM (separatio) ─────────────────────────────────────────
ANTHROPIC_API_KEY=TU_API_KEY_AQUI
# OPENAI_API_KEY=            # solo si PROVIDER = "openai"
# GEMINI_API_KEY=            # solo si PROVIDER = "gemini"

# ── Miniflux (separatio) ────────────────────────────────────
# Token del usuario threat_intel (id 12) en CT 112 — NO el de admin.
MINIFLUX_API_TOKEN=TU_TOKEN_AQUI

# ── Reputación de IPs (ipcheck / enricher ip_reputation) ────
ABUSEIPDB_API_KEY=TU_API_KEY_AQUI
ABUSECH_API_KEY=TU_API_KEY_AQUI     # https://auth.abuse.ch — URLhaus y ThreatFox
OTX_API_KEY=TU_API_KEY_AQUI
VIRUSTOTAL_API_KEY=TU_API_KEY_AQUI

# ── Otras fuentes (sin uso en el código hoy; reservadas) ────
URLSCAN_API_KEY=TU_API_KEY_AQUI
PULSEDIVE_API_KEY=TU_API_KEY_AQUI
VULNERS_API_KEY=TU_API_KEY_AQUI
INTELX_API_KEY=TU_API_KEY_AQUI

# ── Tor (opcional, herramientas de consola) ─────────────────
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
ABUSECH_API_KEY_2=
